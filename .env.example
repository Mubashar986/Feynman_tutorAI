# ==============================================================================
# AI-Powered Adaptive Exam Learning Platform — Environment Configuration
# ==============================================================================
# Copy this file to '.env' in your project root or 'backend/' directory:
#   cp .env.example .env
#
# 💡 ZERO-SETUP LOCAL GUARANTEE:
# All variables below come with safe, zero-dependency local defaults.
# You can run the entire backend offline using SQLite and local Qdrant disk storage
# without setting up external servers or paying for cloud services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AI-Powered Adaptive Exam Learning Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # "development" | "staging" | "production"
DEBUG=True

# Allowed Frontend CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"


# ------------------------------------------------------------------------------
# 2. Relational Database (System of Record)
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL (Default): Uses async SQLite file in ./data/app.db (0 setup, 0 passwords)
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# • PRODUCTION / STAGING: PostgreSQL async connection string
#   Example: postgresql+asyncpg://postgres:your_password@localhost:5432/exam_learning_db
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/exam_db"

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False


# ------------------------------------------------------------------------------
# 3. Vector Database & Semantic Retrieval (Qdrant)
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL (Default): Uses embedded local disk storage in ./data/vector_db (0 setup, 0 API keys)
QDRANT_MODE="local"  # "local" (disk/memory) or "server" (cloud/docker)
QDRANT_PATH="./data/vector_db"

# • PRODUCTION / CLUSTER (Optional):
#   Get a free Qdrant cloud cluster: https://cloud.qdrant.io/
# QDRANT_MODE="server"
# QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""


# ------------------------------------------------------------------------------
# 4. Multi-Provider LLM & AI Gateway (PRD §27, FR-023)
# ------------------------------------------------------------------------------
# The platform supports multiple LLM providers with automatic fallback.
# You only need ONE active provider to run AI features, or use local Ollama for $0!

# Default Provider to use ("openrouter" | "groq" | "ollama" | "openai" | "anthropic" | "gemini" | "deepseek" | "xai")
DEFAULT_LLM_PROVIDER="openrouter"

# --- Option A: OpenRouter (RECOMMENDED — 1 Key for DeepSeek, Llama, Claude, GPT) ---
# Portal: https://openrouter.ai/keys (Generous free & low-cost models available)
OPENROUTER_API_KEY=""

# --- Option B: Groq Cloud (Ultra-Fast 500 T/s Free Tier for Llama 3.3 70B) ---
# Portal: https://console.groq.com/keys
GROQ_API_KEY=""

# --- Option C: Local Ollama (100% Free, Offline, Zero API Keys) ---
# Download: https://ollama.com (Run: 'ollama run llama3.1' or 'ollama run qwen2.5')
OLLAMA_BASE_URL="http://localhost:11434"

# --- Option D: xAI / Grok ---
# Portal: https://console.x.ai/
XAI_API_KEY=""

# --- Option E: DeepSeek API (Direct) ---
# Portal: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# --- Option F: Together AI ---
# Portal: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=""

# --- Option G: Commercial Standard Providers ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""


# ------------------------------------------------------------------------------
# 5. Caching & Background Task Queue (Redis + ARQ)
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL: In-memory cache is used when CACHE_ENABLED=False
CACHE_ENABLED=False
REDIS_URL="redis://localhost:6379/0"


# ------------------------------------------------------------------------------
# 6. Object Storage (Uploaded Books, PDFs & Past Papers)
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL (Default): Saves untrusted uploads to ./data/uploads/
STORAGE_BACKEND="local"  # "local" | "s3" | "minio"
LOCAL_STORAGE_PATH="./data/uploads"

# • S3 / Cloudflare R2 / MinIO (Optional for production):
# S3_BUCKET_NAME=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="us-east-1"
# S3_ENDPOINT_URL=""


# ------------------------------------------------------------------------------
# 7. Authentication & Security (Server-Side RBAC)
# ------------------------------------------------------------------------------
# Change SECRET_KEY in production to a secure random string (e.g. 'openssl rand -hex 32')
SECRET_KEY="dev-insecure-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
