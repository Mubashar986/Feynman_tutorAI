# ==============================================================================
# AI-Powered Adaptive Exam Learning Platform — Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the project root or 'backend/':
#   cp .env.example .env
#
# 💡 ZERO-SETUP LOCAL GUARANTEE:
# All variables below come pre-configured with zero-dependency local defaults.
# You can run the entire platform offline using local SQLite and Qdrant disk storage
# without installing external servers or paying for cloud databases!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="AI-Powered Adaptive Exam Learning Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL (Default): Local async SQLite database in ./data/app.db
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

# • PRODUCTION (Optional): PostgreSQL async connection string
# DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/exam_learning_db"

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
# • ZERO-SETUP LOCAL (Default): Embedded local disk storage in ./data/vector_db
QDRANT_MODE="local"
QDRANT_PATH="./data/vector_db"

# • PRODUCTION / CLOUD (Optional):
# QDRANT_MODE="server"
# QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Multi-Provider LLM & AI Gateway (Optional — Pick ANY one, or use Mocks / Ollama)
# ------------------------------------------------------------------------------
# --- Option A: OpenRouter (Recommended — 1 key for DeepSeek, Llama, Claude, GPT) ---
# Portal: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# --- Option B: Groq Cloud (Ultra-Fast 500 T/s Free Tier) ---
# Portal: https://console.groq.com/keys
GROQ_API_KEY=""

# --- Option C: Local Ollama (100% Free, Offline, Zero API Keys) ---
# Download: https://ollama.com (Run: 'ollama run llama3.1' or 'ollama run qwen2.5')
OLLAMA_BASE_URL="http://localhost:11434"

# --- Option D: xAI / Grok ---
# Portal: https://console.x.ai/
XAI_API_KEY=""

# --- Option E: DeepSeek API (Direct) ---
# Portal: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# --- Option F: OpenAI / Anthropic / Google Gemini ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Caching & Background Workers
# ------------------------------------------------------------------------------
CACHE_ENABLED=False
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 6. Authentication & Security
# ------------------------------------------------------------------------------
SECRET_KEY="dev-insecure-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
