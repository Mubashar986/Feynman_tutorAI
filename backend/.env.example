# ==============================================================================
# AI-Powered Adaptive Exam Learning Platform — Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' in your 'backend/' directory or project root:
#   cp .env.example .env
#
# 💡 ZERO-SETUP LOCAL GUARANTEE:
# All variables below come with safe, zero-dependency local defaults.
# You can run the entire backend offline using SQLite and local Qdrant disk storage
# without setting up external servers or paying for cloud services.
# ==============================================================================

# 1. Core Application & Server Settings
PROJECT_NAME="AI-Powered Adaptive Exam Learning Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# 2. Relational Database (System of Record)
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

# 3. Vector Database (Qdrant Local Disk)
QDRANT_MODE="local"
QDRANT_PATH="./data/vector_db"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# 4. Multi-Provider LLM & AI Gateway
DEFAULT_LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""       # https://openrouter.ai/keys
GROQ_API_KEY=""             # https://console.groq.com/keys
OLLAMA_BASE_URL="http://localhost:11434" # https://ollama.com
XAI_API_KEY=""              # https://console.x.ai/
DEEPSEEK_API_KEY=""         # https://platform.deepseek.com/api_keys
TOGETHER_API_KEY=""         # https://api.together.xyz/settings/api-keys
OPENAI_API_KEY=""           # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=""        # https://console.anthropic.com/
GEMINI_API_KEY=""           # https://aistudio.google.com/app/apikey

# 5. Caching & Background Task Queue
CACHE_ENABLED=False
REDIS_URL="redis://localhost:6379/0"

# 6. Object Storage (Uploaded Resources)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/uploads"

# 7. Authentication & Security
SECRET_KEY="dev-insecure-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
