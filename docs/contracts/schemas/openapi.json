        "operationId": "readiness_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Check Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Authentication & RBAC",
          "Authentication & RBAC"
        ],
        "summary": "Register a new platform user",
        "description": "Registers a new student, instructor, or admin user.\nEnforces email uniqueness and bcrypt password hashing.",
