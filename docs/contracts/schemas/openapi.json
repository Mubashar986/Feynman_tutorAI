          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Authentication & RBAC",
          "Authentication & RBAC"
        ],
        "summary": "Get current authenticated user profile",
        "description": "Returns the authenticated user profile for the caller.",
        "operationId": "get_me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
